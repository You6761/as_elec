{% extends 'base.html.twig' %}
{% block body %}
	<form action="{{ path('app_login') }}" method="post">
		<div class="mb-3">
			<label for="inputEmail" class="form-label">Adresse email</label>
			<input type="email" name="_username" id="inputEmail" class="form-control" required>
		</div>
		<div class="mb-3">
			<label for="inputPassword" class="form-label">Mot de passe</label>
			<input type="password" name="_password" id="inputPassword" class="form-control" required>
		</div>
		<div class="mb-3">
			<input type="hidden" name="_token" value="{{ csrf_token('authenticate') }}">
			<button type="submit" class="btn btn-primary">Se connecter</button>
		</div>

	</form>
{% endblock %}
