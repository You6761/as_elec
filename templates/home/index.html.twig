{% extends 'base.html.twig' %}

{% block title %}Entreprise d'Électricité
{% endblock %}

{% block body %}
	<header>
		<h1>Entreprise</h1>
		<nav class="navbar bg-primary text-center" data-bs-theme="dark">
			<a href="#service">Service</a>
			<a href="#contact">Contact</a>
		</nav>

	</header>

	<div class="container" id="services">
		<h2>Nos Services</h2>
		<div class="service-box">
