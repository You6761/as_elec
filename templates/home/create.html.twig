{% extends 'base.html.twig' %}

{% block title %}Demande de Devis
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h2 class="text-center mb-4">Demande de Devis</h2>
		<div class="card p-4 shadow-lg">
			{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
			<div class="row">
				<div class="col-md-6">
					{{ form_row(form.nom, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="col-md-6">
					{{ form_row(form.prenom, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>

			<div class="row">
				<div class="col-md-6">
					{{ form_row(form.ville, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="col-md-6">
					{{ form_row(form.adresse, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>

			<div class="row">
				<div class="col-md-6">
					{{ form_row(form.numero, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>

			<div class="row">
				<div class="col-md-12">
					{{ form_row(form.descriptionTravaux, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>

			<div class="row">
				<div class="col-md-12">
					<label class="fw-bold">Type de logement</label>
					<div class="form-check">
						{{ form_widget(form.typeHabitat) }}
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-6">
					{{ form_row(form.estimationTravaux, {'attr': {'class': 'form-select'}}) }}
				</div>
			</div>

			<div class="row">
				<div class="col-md-12">
					{{ form_row(form.plusDeDetails, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>
			<div class="row">
				<div class="col-md-12">
					{{ form_row(form.mailClient, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>


			{{ form_end(form) }}
			{% for message in app.flashes('success') %}
				<div class="flash-notice">
					{{ message }}
				</div>
			{% endfor %}
		</div>
	</div>
{% endblock %}
